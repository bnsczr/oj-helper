{
  "manifest_version": 3,
  "name": "Codeforces Helper Local",
  "version": "1.13.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://codeforces.com/*",
    "https://www.codeforces.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "+ 新建当前 Codeforces 题目文件",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "plus16.png",
      "32": "plus32.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://www.codeforces.com/*"
      ],
      "js": [
        "problem.js",
        "samples.js",
        "statement.js",
        "open-settings.js",
        "dashboard.js",
        "shortcut.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*",
        "https://www.codeforces.com/*"
      ],
      "js": [
        "languages.js",
        "verdict.js",
        "content.js"
      ]
    }
  ]
}
