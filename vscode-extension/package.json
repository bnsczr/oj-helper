{
  "name": "oj-helper",
  "displayName": "oj-helper",
  "description": "通过右上角 + 新建 Codeforces 题目文件。",
  "version": "1.0.0",
  "publisher": "oj-helper-local",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onView:codeforcesHelper.files"],
  "contributes": {
    "commands": [
      {"command": "codeforcesHelper.newProblem", "title": "oj-helper: 新建题目文件", "icon": "$(add)"},
      {"command": "codeforcesHelper.settings", "title": "oj-helper: 设置保存目录", "icon": "$(gear)"}
    ],
    "configuration": {
      "title": "oj-helper",
      "properties": {
        "codeforcesHelper.directory": {
          "type": "string",
          "scope": "machine-overridable",
          "markdownDescription": "题目文件保存目录的**绝对路径**，例如 `E:\\code\\CF`。不预设路径；未设置时无法新建文件。请先创建该目录。"
        }
      }
    },
    "views": {"explorer": [{"id": "codeforcesHelper.files", "name": "oj-helper"}]},
    "viewsWelcome": [{"view": "codeforcesHelper.files", "contents": "[新建题目文件](command:codeforcesHelper.newProblem)\n[设置保存目录](command:codeforcesHelper.settings)\n点击右上角 +，输入题号即可新建 .cpp 文件。"}],
    "menus": {
      "editor/title": [{"command": "codeforcesHelper.newProblem", "group": "navigation@1"}],
      "view/title": [
        {"command": "codeforcesHelper.newProblem", "when": "view == codeforcesHelper.files", "group": "navigation@1"},
        {"command": "codeforcesHelper.settings", "when": "view == codeforcesHelper.files", "group": "navigation@2"}
      ]
    }
  }
}
